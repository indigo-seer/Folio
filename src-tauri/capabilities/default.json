{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Folium",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "aptabase:allow-track-event",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCONFIG"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    }
  ]
}
